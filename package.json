{
  "name": "website",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && cp dist/index.html dist/404.html",
    "postbuild": "react-snap",
    "check": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "reactSnap": {
    "source": "dist",
    "minifyHtml": {
      "collapseWhitespace": true,
      "removeComments": true
    },
    "puppeteerArgs": ["--no-sandbox", "--disable-setuid-sandbox"],
    "puppeteerExecutablePath": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "inlineCss": false,
    "skipThirdPartyRequests": true,
    "include": [
      "/",
      "/pricing",
      "/privacy",
      "/terms",
      "/offer",
      "/how-to-use",
      "/blog",
      "/blog/grammarly-vs-textglow-ai-writer",
      "/blog/how-to-write-cold-emails-that-get-replies",
      "/blog/multilingual-emails-native",
      "/blog/overcome-writers-block-ai",
      "/blog/quillbot-vs-textglow",
      "/blog/sound-confident-on-slack",
      "/blog/stop-chatgpt-copy-paste-linkedin",
      "/blog/tinder-openers-ai-rizz",
      "/blog/why-tone-matters-more-than-grammar",
      "/blog/non-native-english-resume",
      "/gmail",
      "/linkedin",
      "/slack",
      "/tinder",
      "/translate"
    ]
  },
  "dependencies": {
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "main": "^1000.0.1",
    "postcss": "^8.5.6",
    "react-snap": "^1.23.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^5.4.21"
  }
}

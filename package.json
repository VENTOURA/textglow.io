{
  "name": "website",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "dev:vite": "vite",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:vite": "tsc -b && vite build && cp dist/index.html dist/404.html && react-snap && node scripts/patch-seo.mjs",
    "check": "tsc -b && ASTRO_TELEMETRY_DISABLED=1 astro check",
    "lint": "eslint .",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "preview:vite": "vite preview",

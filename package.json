    "astro:check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "route:check": "node scripts/check-route-registry.mjs"
  },
  "reactSnap": {
    "source": "dist",
    "waitFor": "#root > *",
    "delay": 1000,
    "concurrency": 1,
    "crawl": false,
    "minifyHtml": {
      "collapseWhitespace": true,
      "removeComments": true
    },
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ],
    "puppeteerExecutablePath": null,
    "inlineCss": true,
    "skipThirdPartyRequests": true,
